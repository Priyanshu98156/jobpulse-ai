# Google Gemini API key for match scoring, cover letter tailoring, and screening question answers
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Adzuna API credentials (free at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Background Sync Interval in Minutes (e.g. 120 = every 2 hours)
SYNC_INTERVAL_MINUTES=120
AUTO_SYNC_ENABLED=True

# Match Score Threshold for Desktop Notification (0-100)
NOTIFICATION_MIN_SCORE=80

